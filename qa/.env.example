# Load explicitly: node --env-file=qa/.env scripts/qa-environment.cjs start
# Never set a Mongo URI here. The launcher owns a new disposable replica set.
QA_HOST=127.0.0.1
QA_RUN_ID=local
QA_API_PORT=3300
QA_UI_PORT=55173
# Optional absolute path to a trusted mongod already installed on your machine:
# MONGOMS_SYSTEM_BINARY=C:/tools/mongodb/bin/mongod.exe
# MONGOMS_RUNTIME_DOWNLOAD=false
